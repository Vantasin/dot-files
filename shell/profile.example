# ~/.profile example for machines where you want local login-shell environment.
# This repo does not install ~/.profile by default.

path_prepend() { case ":$PATH:" in *":$1:"*) ;; *) PATH="$1:$PATH";; esac; }

[ -d "$HOME/.local/bin" ] && path_prepend "$HOME/.local/bin"
[ -d "$HOME/bin" ] && path_prepend "$HOME/bin"
export PATH

# If bash login shell is interactive, load ~/.bashrc.
if [ -n "${BASH_VERSION-}" ]; then
  case $- in
    *i*) [ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc" ;;
  esac
fi
