# Global Git configuration. Host-local settings load last from ~/.gitconfig.local.

[init]
	defaultBranch = main

[core]
	excludesFile = ~/.config/git/ignore
	pager = less -FRX

[color]
	ui = auto

[pull]
	ff = only

[push]
	default = simple
	autoSetupRemote = true

[merge]
	conflictstyle = zdiff3

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[user]
	signingkey = ~/.ssh/git_signing_key.pub

[include]
	path = ~/.gitconfig.local
