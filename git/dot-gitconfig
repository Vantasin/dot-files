# Global Git configuration. Personal identity is loaded from ~/.gitconfig.local if present.

[include]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[core]
	excludesFile = ~/.config/git/ignore
	pager = less -FRX

[color]
	ui = auto

[pull]
	ff = only

[push]
	default = simple
	autoSetupRemote = true

[merge]
	conflictstyle = zdiff3
